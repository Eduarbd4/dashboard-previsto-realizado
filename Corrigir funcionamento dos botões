  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <style>
    :root{--paper:#f6f2ea;--card:#fffdf9;--ink:#17233e;--muted:#6e716e;--line:#ddd6c9;--gold:#c4972d;--blue:#254d79;--green:#28735b;--red:#aa4d45}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,sans-serif}button,input{font:inherit}button{cursor:pointer}.wrap{max-width:1180px;margin:auto;padding:0 24px}.top{display:flex;justify-content:space-between;align-items:end;gap:24px;padding-top:38px;padding-bottom:24px}.eyebrow{font-size:10px;letter-spacing:.16em;font-weight:800;color:var(--gold)}h1,h2,h3{font-family:Georgia,serif}h1{font-size:39px;margin:7px 0 5px}h1 i{color:var(--gold;font-weight:400)}.sub,.muted{color:var(--muted);font-size:12px}.controls{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.controls input,.search{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:9px 11px;color:var(--ink)}button{border:1px solid var(--ink);background:transparent;color:var(--ink);border-radius:7px;padding:9px 12px;font-size:11px;font-weight:bold}.primary{background:var(--ink);color:white}.admin{color:var(--green);font-size:10px}.actions{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:22px}.upload{background:var(--card);border:1px solid var(--line);border-top:3px solid var(--blue);border-radius:13px;padding:16px;display:grid;grid-template-columns:1fr auto;gap:8px}.upload.actual{border-top-color:var(--green)}.upload b,.upload span{display:block}.upload span{margin-top:5px;color:var(--muted);font-size:10px}.tabs{border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;gap:26px;overflow:auto}.tabs button{border:0;border-radius:0;position:relative;padding:15px 1px 13px;color:var(--muted);white-space:nowrap}.tabs button.active{color:var(--ink)}.tabs button.active:after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:3px;background:var(--gold)}main{padding-top:28px;padding-bottom:50px}.heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:20px}.heading h2{font-size:28px;margin:5px 0 0;text-transform:capitalize}.heading p{max-width:490px;text-align:right;line-height:1.5}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}.kpi{background:var(--card);border:1px solid var(--line);border-top:3px solid var(--ink);border-radius:11px;padding:17px}.kpi.blue{border-top-color:var(--blue)}.kpi.green{border-top-color:var(--green)}.kpi.red{border-top-color:var(--red)}.kpi.gold{border-top-color:var(--gold)}.kpi span,.kpi small{display:block;color:var(--muted);font-size:10px}.kpi span{text-transform:uppercase;letter-spacing:.08em;font-weight:bold}.kpi b{display:block;font:24px Georgia,serif;margin:14px 0 9px}.panel{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-bottom:15px}.panelHead{padding:17px 18px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between}.panelHead h3{margin:4px 0 0}.table{overflow:auto}table{width:100%;border-collapse:collapse;min-width:850px;font-size:10px}th,td{padding:12px 13px;border-bottom:1px solid #ece6da;text-align:left}th{font-size:8px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);background:#faf7f1}.right{text-align:right}.match{color:var(--green);font-weight:bold}.noMatch{color:var(--red);font-weight:bold}.excluded{opacity:.48;text-decoration:line-through}.pill{font-size:8px;text-transform:uppercase;padding:4px 7px;border-radius:15px;background:#e8eef5;color:var(--blue)}.pill.realizado{background:#e4f0eb;color:var(--green)}.empty{text-align:center;padding:45px;color:var(--muted);font-size:11px}.empty b{display:block;color:var(--ink);font:18px Georgia,serif;margin-bottom:7px}.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}.toolbar .search{flex:1;min-width:250px}.danger{border-color:var(--red);color:var(--red)}.rules{display:grid;grid-template-columns:1fr 1fr;gap:12px}.rule{background:var(--card);border:1px solid var(--line);border-left:4px solid var(--gold);padding:17px;border-radius:9px}.rule p{color:var(--muted);font-size:11px;line-height:1.6}.notice{position:fixed;top:18px;right:18px;background:var(--ink);color:white;padding:12px 15px;border-radius:8px;z-index:10;font-size:11px}.modal{position:fixed;inset:0;background:#10182dbb;display:none;place-items:center;z-index:20;padding:20px}.modal.open{display:grid}.login{width:min(420px,100%);background:var(--card);border-radius:15px;padding:25px}.login h2{margin-top:0}.login input{width:100%;padding:11px;border:1px solid var(--line);border-radius:7px;margin:6px 0}.login .buttons{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}.updated{text-align:center;color:var(--muted);font-size:9px;padding:18px}.hidden{display:none!important}@media(max-width:800px){.top{display:block}.controls{margin-top:20px}.actions{grid-template-columns:1fr}.kpis{grid-template-columns:1fr 1fr}.heading{display:block}.heading p{text-align:left}.rules{grid-template-columns:1fr}}@media(max-width:430px){.wrap{padding:0 15px}.kpis{grid-template-columns:1fr}h1{font-size:33px}.upload{grid-template-columns:1fr}.upload button{width:100%}}
  </style>
</head>
<body>
<header class="wrap top"><div><span class="eyebrow">CONTROLE FINANCEIRO</span><h1>Previsto × Realizado</h1><div class="sub">Planejamento mensal e atualização compartilhada dos pagamentos</div></div><div class="controls"><input id="month" type="month"><span id="adminStatus" class="admin">Visualização pública</span><button id="loginBtn">Área administrativa</button><button id="logoutBtn" class="hidden">Sair</button></div></header>
<section class="wrap actions" id="adminActions"><article class="upload"><div><b>01 · Salvar previsão mensal</b><span id="forecastInfo">Somente administradores podem importar</span></div><button class="primary adminOnly" data-file="forecastFile">Importar previsão</button><input class="hidden" id="forecastFile" type="file" accept=".xlsx,.xls,.csv"></article><article class="upload actual"><div><b>02 · Atualizar pagamentos</b><span id="actualInfo">A atualização substitui o relatório semanal anterior</span></div><button class="primary adminOnly" data-file="actualFile">Atualizar pagamentos</button><input class="hidden" id="actualFile" type="file" accept=".xlsx,.xls,.csv"></article></section>
<nav class="tabs wrap" id="tabs"><button class="active" data-tab="overview">Visão geral</button><button data-tab="compare">Previsto x realizado</button><button data-tab="unexpected">Não previstos</button><button data-tab="categories">Categorias</button><button data-tab="base">Base consolidada</button><button data-tab="rules">Regras</button></nav>
<main class="wrap" id="content"></main><div class="updated" id="updated"></div><div id="notice" class="notice hidden"></div>
<div class="modal" id="loginModal"><form class="login" id="loginForm"><h2>Área administrativa</h2><p class="muted">Entre com o e-mail e a senha cadastrados no Supabase.</p><input id="email" type="email" placeholder="E-mail" required><input id="password" type="password" placeholder="Senha" required><div class="buttons"><button type="button" id="cancelLogin">Cancelar</button><button class="primary">Entrar</button></div></form></div>
<script>
// COLE AQUI OS DADOS PÚBLICOS DO SEU PROJETO SUPABASE
const SUPABASE_URL = 'sb_publishable_ZLue4j1oo6ULkFIWVhkwNQ_iLkQHgah';
const SUPABASE_ANON_KEY = 'sb_publishable_ZLue4j1oo6ULkFIWVhkwNQ_iLkQHgah';
let db = null;
let record={forecast:[],actual:[],metadata:{}}, session=null, tab='overview', search='';
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const norm=v=>String(v??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]/g,'');
const money=v=>new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(v||0);
const pct=v=>new Intl.NumberFormat('pt-BR',{maximumFractionDigits:1}).format(v||0)+'%';
const currentMonth=()=>{const d=new Date;return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`};
const monthName=s=>{const[y,m]=s.split('-').map(Number);return new Intl.DateTimeFormat('pt-BR',{month:'long',year:'numeric'}).format(new Date(y,m-1,1))};
const dateText=s=>s?new Intl.DateTimeFormat('pt-BR').format(new Date(s.length===10?s+'T12:00:00':s)):'—';
function pick(o,names){for(const n of names){const e=Object.entries(o).find(([k])=>norm(k)===norm(n));if(e&&e[1]!==''&&e[1]!=null)return e[1]}return''}
function numberValue(v){if(typeof v==='number')return v;let s=String(v??'').replace(/R\$|\s/g,'');if(s.includes(','))s=s.replace(/\./g,'').replace(',','.');return Number(s)||0}
function dateValue(v){if(!v)return'';if(v instanceof Date)return v.toISOString().slice(0,10);if(typeof v==='number')return new Date(Math.round((v-25569)*86400000)).toISOString().slice(0,10);const s=String(v),br=s.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);if(br)return`${br[3]}-${br[2].padStart(2,'0')}-${br[1].padStart(2,'0')}`;const d=new Date(s);return isNaN(d)?'':d.toISOString().slice(0,10)}
function parseRows(raw,source){return raw.map((o,i)=>{const description=String(pick(o,['Descrição','Descricao','Histórico','Historico','Nome','Observação']));const party=String(pick(o,['Fornecedor','Cliente','Fornecedor / Cliente','Pessoa','Nome do fornecedor']));const type=String(pick(o,['Tipo','Classificação automática','Classificacao automatica','Regra']));const amount=numberValue(pick(o,source==='previsto'?['Valor previsto','Valor original','Valor','Total','Valor a pagar']:['Valor pago','Valor realizado','Valor recebido','Valor','Total']));const dueDate=dateValue(pick(o,['Vencimento','Data de vencimento','Data prevista','Competência']));const paymentDate=dateValue(pick(o,['Data de pagamento','Pagamento','Data pago','Data da baixa','Data']));const category=String(pick(o,['Categoria','Categoria 1','Plano de contas','Conta']));const costCenter=String(pick(o,['Centro de custo','Departamento','Unidade']));const ext=String(pick(o,['ID','Identificador','Código','Numero','Número']));return{id:[norm(ext),norm(party),norm(description),dueDate,paymentDate,amount.toFixed(2)].join('|')||source+i,description:description||'Sem descrição',party:party||'Não informado',category:category||'Sem categoria',costCenter:costCenter||'Não informado',type:type||'—',dueDate,paymentDate,amount,source}}).filter(r=>r.amount||r.party!=='Não informado')}
const isExclude=r=>norm(r.type).includes('excluir');
const isFopag=r=>norm(r.type).includes('fopag')||norm(r.description).includes('fopag')||norm(r.category).includes('folhadepagamento');
const isPrediction=r=>norm(r.type).includes('previsao')||norm(r.type).includes('previsto');
const isGabriel=r=>norm(r.party+' '+r.description).includes('gabriel')&&norm(r.party+' '+r.description).includes('adiantamento');
const key=r=>`${norm(r.party)}|${norm(r.description)}|${r.dueDate}|${r.amount.toFixed(2)}`, loose=r=>`${norm(r.party)}|${norm(r.description)}`;
function analyze(){const forecast=record.forecast.filter(r=>!isExclude(r)),actual=record.actual.filter(r=>!isExclude(r)),exact=new Map(forecast.map(r=>[key(r),r])),pools=new Map,used=new Set;forecast.forEach(r=>pools.set(loose(r),[...(pools.get(loose(r))||[]),r]));const fopag=forecast.filter(isFopag),gabriel=forecast.filter(isGabriel);const matches=actual.map(a=>{let f=exact.get(key(a));if(!f)f=(pools.get(loose(a))||[]).find(x=>!used.has(x.id));if(!f&&isFopag(a))f=fopag[0];if(!f&&isGabriel(a))f=gabriel[0];if(f)used.add(f.id);return{actual:a,forecast:f}});const unexpected=matches.filter(x=>!x.forecast&&!isPrediction(x.actual)).map(x=>x.actual),pending=forecast.filter(f=>!used.has(f.id)&&!isPrediction(f)),forecastTotal=forecast.reduce((s,r)=>s+r.amount,0),actualTotal=actual.reduce((s,r)=>s+r.amount,0);return{forecast,actual,matches,unexpected,pending,forecastTotal,actualTotal,difference:actualTotal-forecastTotal,execution:forecastTotal?actualTotal/forecastTotal*100:0}}
function notify(t){$('#notice').textContent=t;$('#notice').classList.remove('hidden');setTimeout(()=>$('#notice').classList.add('hidden'),4500)}
async function loadMonth(){const competence=$('#month').value;const{data,error}=await db.from('financial_months').select('*').eq('competence',competence).maybeSingle();if(error){notify('Erro ao carregar: '+error.message);return}record=data||{forecast:[],actual:[],metadata:{}};render();subscribe()}
async function saveMonth(){const payload={competence:$('#month').value,forecast:record.forecast,actual:record.actual,metadata:record.metadata,updated_at:new Date().toISOString(),updated_by:session.user.id};const{error}=await db.from('financial_months').upsert(payload,{onConflict:'competence'});if(error)throw error;await loadMonth()}
let channel;function subscribe(){if(channel)db.removeChannel(channel);channel=db.channel('month-'+$('#month').value).on('postgres_changes',{event:'*',schema:'public',table:'financial_months',filter:'competence=eq.'+$('#month').value},()=>loadMonth()).subscribe()}
function heading(title,text){return`<div class="heading"><div><span class="eyebrow">RESUMO DA COMPETÊNCIA</span><h2>${title}</h2></div><p class="muted">${text}</p></div>`}
function kpi(label,value,detail,tone){return`<article class="kpi ${tone}"><span>${label}</span><b>${value}</b><small>${detail}</small></article>`}
function table(rows,matches=[],source=false){if(!rows.length)return`<div class="empty"><b>Sem dados nesta área</b>Importe ou atualize as planilhas.</div>`;const map=new Map(matches.map(x=>[x.actual.id,x.forecast])),matchMode=matches.length;return`<div class="table"><table><thead><tr>${source?'<th>Origem</th>':''}<th>Fornecedor</th><th>Descrição</th><th>Tipo</th><th>Categoria</th><th>Data</th>${matchMode?'<th>Conciliação</th>':''}<th class="right">Valor</th></tr></thead><tbody>${rows.map(r=>`<tr class="${isExclude(r)?'excluded':''}">${source?`<td><span class="pill ${r.source}">${r.source}</span></td>`:''}<td><b>${r.party}</b></td><td>${r.description}</td><td>${r.type}</td><td>${r.category}</td><td>${dateText(r.paymentDate||r.dueDate)}</td>${matchMode?`<td>${map.get(r.id)?'<span class="match">✓ Correspondência</span>':'<span class="noMatch">Não previsto</span>'}</td>`:''}<td class="right"><b>${money(r.amount)}</b></td></tr>`).join('')}</tbody></table></div>`}
function render(){const a=analyze(),meta=record.metadata||{};$('#forecastInfo').textContent=meta.forecastFile?`${meta.forecastFile} · ${dateText(meta.forecastAt)}`:'Nenhuma previsão importada';$('#actualInfo').textContent=meta.actualFile?`${meta.actualFile} · ${dateText(meta.actualAt)}`:'Nenhum pagamento importado';$('#updated').textContent=meta.actualAt?`Dados atualizados em ${dateText(meta.actualAt)}. As alterações aparecem automaticamente para todos.`:'';let html='';if(tab==='overview')html=heading(monthName($('#month').value),'A previsão fica salva online e a atualização semanal substitui os pagamentos anteriores.')+`<div class="kpis">${kpi('Total previsto',money(a.forecastTotal),a.forecast.length+' lançamentos','blue')}${kpi('Total realizado',money(a.actualTotal),a.actual.length+' pagamentos','green')}${kpi('Diferença',money(a.difference),a.difference>0?'Acima do previsto':'Abaixo do previsto',a.difference>0?'red':'gold')}${kpi('Execução',pct(a.execution),a.pending.length+' pendentes','')}</div><section class="panel"><div class="panelHead"><div><span class="eyebrow">MAIORES MOVIMENTAÇÕES</span><h3>Pagamentos realizados</h3></div></div>${table([...a.actual].sort((x,y)=>y.amount-x.amount).slice(0,8))}</section>`;if(tab==='compare')html=heading('Previsto x realizado','FOPAG é conciliada de forma agrupada e adiantamentos permanecem separados.')+`<div class="kpis">${kpi('Previstos pendentes',money(a.pending.reduce((s,r)=>s+r.amount,0)),a.pending.length+' lançamentos','gold')}${kpi('Não previstos',money(a.unexpected.reduce((s,r)=>s+r.amount,0)),a.unexpected.length+' pagamentos','red')}${kpi('Realizado',money(a.actualTotal),pct(a.execution),'green')}</div><section class="panel">${table(a.actual,a.matches)}</section>`;if(tab==='unexpected')html=heading('Pagamentos não previstos','Somente realizados sem correspondência válida. EXCLUIR, PREVISÃO conciliada e FOPAG vinculada não aparecem.')+`<section class="panel">${table(a.unexpected)}</section>`;if(tab==='categories'){const m=new Map;[...a.forecast,...a.actual].forEach(r=>{const v=m.get(r.category)||{p:0,a:0};r.source==='previsto'?v.p+=r.amount:v.a+=r.amount;m.set(r.category,v)});html=heading('Categorias','Comparação por categoria da previsão válida com o realizado.')+`<section class="panel">${table([...m].map(([category,v],i)=>({id:i,party:category,description:'Previsto '+money(v.p),type:'Diferença '+money(v.a-v.p),category:'Realizado '+money(v.a),costCenter:'',dueDate:'',paymentDate:'',amount:v.a,source:'realizado'})))}</section>`}if(tab==='base'){const rows=[...record.forecast,...record.actual].filter(r=>(r.party+' '+r.description+' '+r.category+' '+r.type).toLowerCase().includes(search.toLowerCase()));html=heading('Base consolidada','Registros EXCLUIR permanecem visíveis para conferência, mas não entram nos indicadores.')+`<div class="toolbar"><input class="search" id="search" value="${search}" placeholder="Buscar fornecedor, descrição, tipo ou categoria"><button id="exportBtn">Exportar backup</button><button class="danger adminOnly" id="deleteBtn">Apagar competência</button></div><section class="panel">${table(rows,[],true)}</section>`}if(tab==='rules')html=heading('Regras da conciliação','Critérios aplicados aos indicadores e aos pagamentos não previstos.')+`<div class="rules"><article class="rule"><b>EXCLUIR</b><p>Fica na base para conferência, mas não entra nos totais nem em não previstos.</p></article><article class="rule"><b>FOPAG</b><p>A previsão agrupada é vinculada aos pagamentos detalhados da folha.</p></article><article class="rule"><b>ADIANTAMENTO</b><p>Adiantamentos, como o do Gabriel, ficam separados da FOPAG.</p></article><article class="rule"><b>PREVISÃO / PREVISTO</b><p>Realizado conciliado não entra como pagamento não previsto.</p></article></div>`;$('#content').innerHTML=html;bindDynamic();updateAdminUI()}
function bindDynamic(){const s=$('#search');if(s)s.oninput=e=>{search=e.target.value;render()};const ex=$('#exportBtn');if(ex)ex.onclick=()=>{const b=new Blob([JSON.stringify(record,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='backup-'+$('#month').value+'.json';a.click()};const del=$('#deleteBtn');if(del)del.onclick=async()=>{if(!session||!confirm('Apagar esta competência para todos?'))return;const{error}=await db.from('financial_months').delete().eq('competence',$('#month').value);if(error)notify(error.message);else loadMonth()}}
function updateAdminUI(){const on=!!session;$('#adminStatus').textContent=on?'Administrador conectado':'Visualização pública';$('#loginBtn').classList.toggle('hidden',on);$('#logoutBtn').classList.toggle('hidden',!on);$$('.adminOnly').forEach(x=>x.classList.toggle('hidden',!on))}
$$('[data-file]').forEach(b=>b.onclick=()=>$('#'+b.dataset.file).click());
async function importFile(file,source){if(!session)return notify('Entre como administrador.');const wb=XLSX.read(await file.arrayBuffer(),{type:'array',cellDates:true}),rows=parseRows(XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{defval:''}),source),unique=[...new Map(rows.map(r=>[r.id,r])).values()];record[source==='previsto'?'forecast':'actual']=unique;record.metadata={...(record.metadata||{}),[source==='previsto'?'forecastFile':'actualFile']:file.name,[source==='previsto'?'forecastAt':'actualAt']:new Date().toISOString()};try{await saveMonth();notify(source==='previsto'?'Previsão salva para todos.':'Pagamentos atualizados para todos, sem duplicidades.')}catch(e){notify('Erro ao salvar: '+e.message)}}
$('#forecastFile').onchange=e=>{const f=e.target.files[0];e.target.value='';if(f)importFile(f,'previsto')};$('#actualFile').onchange=e=>{const f=e.target.files[0];e.target.value='';if(f)importFile(f,'realizado')};
$('#tabs').onclick=e=>{const b=e.target.closest('[data-tab]');if(!b)return;tab=b.dataset.tab;$$('#tabs button').forEach(x=>x.classList.toggle('active',x===b));render()};$('#month').value=currentMonth();$('#month').onchange=loadMonth;
$('#loginBtn').onclick=()=>$('#loginModal').classList.add('open');$('#cancelLogin').onclick=()=>$('#loginModal').classList.remove('open');$('#loginForm').onsubmit=async e=>{e.preventDefault();const{data,error}=await db.auth.signInWithPassword({email:$('#email').value,password:$('#password').value});if(error)return notify('Login inválido.');session=data.session;$('#loginModal').classList.remove('open');updateAdminUI();notify('Administrador conectado.')};$('#logoutBtn').onclick=async()=>{await db.auth.signOut();session=null;updateAdminUI()};
async function init(){
  updateAdminUI();
  if(SUPABASE_URL.includes('COLE_AQUI')){notify('Configure a URL e a chave pública do Supabase no código.');return}
  try{
    if(!window.supabase) throw new Error('Biblioteca de conexão não carregou');
    db=window.supabase.createClient(SUPABASE_URL.trim(),SUPABASE_ANON_KEY.trim());
    const{data,error}=await db.auth.getSession();
    if(error)throw error;
    session=data.session;
    updateAdminUI();
    await loadMonth();
  }catch(error){
    console.error(error);
    notify('Não foi possível conectar ao banco. Confira a URL e a chave pública.');
  }
}init();
</script></body></html>
